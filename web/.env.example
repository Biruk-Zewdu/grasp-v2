# grasp/web environment — TEMPLATE (safe to commit; no real secrets here)
#
# Setup for a new teammate:
#   1. cp .env.example .env.local
#   2. Fill in the values below (get the real secrets from the project owner
#      over a PRIVATE channel — never paste them into git, chat history, or a PR).
#   3. pnpm install && pnpm dev   →  http://localhost:3000
#
# .env.local is gitignored — your filled-in copy is never committed.

# ── Database (required) ──────────────────────────────────────────────────────
# Supabase Session pooler URL (IPv4). Password must be percent-encoded (@ → %40,
# / → %2F). Ask the owner for this, or use your own read-only DB role.
DATABASE_URL=

# Which frozen corpus to serve. Leave as v1.
SERVE_CORPUS_VERSION=v1

# ── Model provider ───────────────────────────────────────────────────────────
# The app is model-OPTIONAL. Two ways to run:
#
#   A) Zero cost, no key:  set SERVE_MODE=template and leave ANTHROPIC_API_KEY blank.
#      The whole Guide works from the frozen records ($0). Best for UI work/demos.
#
#   B) Live reasoning:     set SERVE_MODE=live and paste your OWN Anthropic key.
#      Use your own key so spend is yours, not the owner's. A per-user budget cap
#      and a dashboard hard cap protect against runaway cost.
MODEL_PROVIDER=anthropic
SERVE_MODE=template
ANTHROPIC_API_KEY=

# Only set these if your account's model ids differ from the defaults:
# ANTHROPIC_MODEL_REASON=claude-sonnet-4-6
# ANTHROPIC_MODEL_CLASSIFY=claude-sonnet-4-6
# ANTHROPIC_MODEL_RENDER=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_PROBE=claude-haiku-4-5-20251001

# To use OpenAI instead: MODEL_PROVIDER=openai + OPENAI_API_KEY=...
# OPENAI_API_KEY=

# ── Anonymous auth (optional) ────────────────────────────────────────────────
# Leave blank to run without auth (progress keyed by a per-tab id, lost on reload).
# To enable persistent sessions, get these PUBLIC values (browser-safe, RLS-gated)
# from the owner or your own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Admin gap queue (optional) ───────────────────────────────────────────────
# Set any secret string, then visit /admin/gaps?key=<that string>
# ADMIN_TOKEN=
