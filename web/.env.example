# grasp-v2/web environment — TEMPLATE (safe to commit; no real secrets)
#
# v2 uses a BRAND-NEW Supabase project (separate from v1). Setup:
#   1. Create a new Supabase project (note the ref + region).
#   2. cp .env.example .env.local and fill in the values below.
#   3. Apply migrations:  supabase db push --db-url "$DATABASE_URL"
#   4. pnpm install && pnpm dev  →  http://localhost:3000
#
# .env.local is gitignored — your filled-in copy is never committed.

# ── Database (required) — the NEW v2 Supabase ────────────────────────────────
# Session pooler URL (IPv4). Password percent-encoded (@ → %40, / → %2F).
DATABASE_URL=

# Which corpus version to serve by default. v2 selects the uploaded artifact at
# runtime, so this is only the fallback "example" label.
SERVE_CORPUS_VERSION=example

# ── Model provider ───────────────────────────────────────────────────────────
# Template mode = zero cost, no key (works fully). Live = real reasoning + builds.
MODEL_PROVIDER=openai
SERVE_MODE=template
OPENAI_API_KEY=

# ── Anonymous auth (optional) — the NEW v2 Supabase's public keys ─────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Admin gap queue (optional) ───────────────────────────────────────────────
# ADMIN_TOKEN=
